{
  "name": "college-timetable-generator",
  "description": "College Timetable Generator Desktop Application with Independent Local SQLite Storage",
  "author": "College Timetable Generator Team",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "vite build && electron-builder --win",
    "electron:portable": "vite build && electron-builder --win portable",
    "electron:all": "vite build && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.college.timetablegenerator",
    "productName": "College Timetable Generator",
    "electronVersion": "32.3.3",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/sql.js/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.wasm"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "College Timetable Generator",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-Portable.${ext}"
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.16.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "electron": "^32.3.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.0.9",
    "vite": "^6.2.0",
    "wait-on": "^9.5.1"
  }
}
